# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่คีย์จริง (ไฟล์ .env.local ถูก gitignore ไว้แล้วผ่านรูปแบบ *.local)
# ขอคีย์ฟรีได้ที่ https://aistudio.google.com/apikey — ห้าม commit คีย์จริงลง git เด็ดขาด

GEMINI_API_KEY=

# ไม่บังคับ — เปลี่ยนรุ่นโมเดลได้ถ้าต้องการ (ค่าเริ่มต้นสมดุลระหว่างคุณภาพ/ความเร็ว/ราคา)
GEMINI_MODEL=gemini-3.8-flash
